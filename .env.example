# Native/local API connection
DATABASE_URL=postgres://postgres:change-me@localhost:5434/bindb?sslmode=disable
PORT=8828

# Docker Compose PostgreSQL settings
POSTGRES_DB=bindb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5434

# Secure defaults
ENRICHMENT_ENABLED=false
HANDY_API_KEY=
HANDY_API_MONTHLY_LIMIT=3000
CORS_ORIGINS=
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
GLOBAL_RATE_LIMIT_RPS=100
GLOBAL_RATE_LIMIT_BURST=200
RATE_LIMIT_MAX_CLIENTS=10000

# PostgreSQL connection pool
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# HTTP server lifecycle
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_HEADER_BYTES=1048576

# Reserved until admin endpoints are implemented
ADMIN_API_KEY=
